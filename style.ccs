/* ============================================================
   GLOBAL RESET & BASE STYLES
============================================================ */
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

.logo{
    width:220px;
    height:auto;
}

:root {
    --bg: #050509;
    --bg-soft: #0b0b10;
    --bg-card: #101018;
    --border-soft: #1f1f2a;
    --accent-red: #ff003c;
    --accent-gold: #d4af37;
    --text-main: #f5f5f5;
    --text-muted: #b3b3c2;
}

body {
    font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    background-color: var(--bg);
    color: var(--text-main);
    line-height: 1.6;
    overflow-x: hidden;
}

/* ============================================================
   TOP NAVIGATION BAR
============================================================ */
.top-nav {
    position: fixed;
    top: 0;
    width: 100%;
    padding: 16px 40px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: rgba(5, 5, 9, 0.9);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid #15151f;
    z-index: 1000;
}

.logo {
    font-size: 1.6rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
}

.nav-links {
    display: flex;
    gap: 24px;
}

.nav-links a {
    color: #fff;
    text-decoration: none;
    font-size: 0.85rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    position: relative;
    padding-bottom: 3px;
}

.nav-links a::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: 0;
    width: 0%;
    height: 2px;
    background: var(--accent-gold);
    transition: width 0.25s ease;
}

.nav-links a:hover::after {
    width: 100%;
}

.lang-toggle {
    border: 1px solid var(--accent-red);
    background: transparent;
    color: var(--accent-red);
    padding: 6px 14px;
    border-radius: 999px;
    cursor: pointer;
    text-transform: uppercase;
    font-size: 0.75rem;
    transition: 0.2s ease;
}

.lang-toggle:hover {
    background: var(--accent-red);
    color: var(--bg);
}

/* ============================================================
   HERO SECTION
============================================================ */
.hero {
    height: 100vh;
    width: 100%;
    background: url("images/satellite.jpg") center/cover no-repeat;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    padding: 140px 60px 0; /* FIXED: prevents hero content from being pushed off-screen */
    position: relative;
    animation: heroZoom 20s ease-in-out infinite alternate;
}

@keyframes heroZoom {
    from { transform: scale(1); }
    to { transform: scale(1.12); }
}

.hero::before {
    content: "";
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at 20% 20%, rgba(212,175,55,0.25), transparent 55%),
                rgba(0,0,0,0.55);
}

.hero-logo,
.hero-title,
.hero-rotate,
.cta-button {
    position: relative;
    z-index: 2;
}

.hero-logo {
    width: 180px;
    opacity: 0;
    animation: fadeIn 1.8s ease forwards;
}

@keyframes fadeIn {
    to { opacity: 1; }
}

.hero-title {
    font-size: 3.2rem;
    margin-top: 24px;
    max-width: 520px;
}

.hero-rotate {
    margin-top: 14px;
    font-size: 1.1rem;
    color: var(--text-muted);
}

.hero-rotate .rotate-item {
    display: inline-block;
    margin-right: 10px;
    opacity: 0.85;
}

.cta-button {
    margin-top: 26px;
    display: inline-block;
    background: linear-gradient(135deg, var(--accent-red), #ff335c);
    padding: 14px 30px;
    color: #fff;
    text-decoration: none;
    font-weight: 600;
    border-radius: 999px;
    box-shadow: 0 10px 25px rgba(255,0,60,0.35);
    transition: 0.2s ease;
}

.cta-button:hover {
    transform: translateY(-2px);
    box-shadow: 0 14px 30px rgba(255,0,60,0.45);
}

/* ============================================================
   SECTION BASE STYLES
============================================================ */
.section {
    padding: 100px 40px;
    max-width: 1200px;
    margin: 0 auto;
}

.section h2 {
    font-size: 2.1rem;
    margin-bottom: 18px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
}

/* ============================================================
   ABOUT SECTION
============================================================ */
.about-wrapper {
    display: flex;
    gap: 40px;
    align-items: flex-start;
    flex-wrap: wrap;
}

.about-wrapper p {
    flex: 1;
    min-width: 280px;
    color: var(--text-muted);
}

.about-images {
    flex: 1;
    min-width: 280px;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
}

.about-images img {
    width: 100%;
    height: 160px;
    object-fit: cover;
    border-radius: 12px;
    border: 1px solid var(--border-soft);
}

/* ============================================================
   WHY CHOOSE US
============================================================ */
.why-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 22px;
    margin-top: 10px;
}

.why-card {
    background: var(--bg-card);
    border-radius: 14px;
    padding: 20px;
    border: 1px solid #181822;
    transition: 0.25s ease;
}

.why-card:hover {
    transform: translateY(-4px);
    border-color: var(--accent-gold);
}

.why-card h3 {
    font-size: 1.05rem;
    margin-bottom: 6px;
}

.why-card p {
    font-size: 0.9rem;
    color: var(--text-muted);
}

/* ============================================================
   SERVICES
============================================================ */
.services-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 24px;
    margin-top: 10px;
}

.service-card {
    background: var(--bg-card);
    padding: 22px;
    border-radius: 14px;
    border: 1px solid #181822;
    transition: 0.25s ease;
}

.service-card:hover {
    transform: translateY(-6px);
    border-color: var(--accent-red);
}

.service-card h3 {
    font-size: 1.05rem;
    margin-bottom: 8px;
}

.service-card p {
    font-size: 0.9rem;
    color: var(--text-muted);
}

/* ============================================================
   INDUSTRIES
============================================================ */
.industries-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 16px;
    margin-top: 10px;
}

.industry-card {
    background: var(--bg-soft);
    border-radius: 999px;
    padding: 10px 18px;
    border: 1px solid var(--border-soft);
    text-align: center;
    font-size: 0.9rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-muted);
}

/* ============================================================
   PROCESS TIMELINE
============================================================ */
.timeline {
    display: flex;
    justify-content: space-between;
    gap: 18px;
    margin-top: 30px;
    flex-wrap: wrap;
    position: relative;
}

.timeline::before {
    content: "";
    position: absolute;
    top: 50%;
    left: 5%;
    right: 5%;
    height: 2px;
    background: linear-gradient(90deg, var(--accent-red), var(--accent-gold));
    opacity: 0.35;
    transform: translateY(-50%);
    z-index: 0;
}

.timeline-step {
    position: relative;
    z-index: 1;
    flex: 1;
    min-width: 140px;
    text-align: center;
}

.timeline-step span {
    display: inline-block;
    padding: 10px 14px;
    border-radius: 999px;
    background: var(--bg-soft);
    border: 1px solid var(--border-soft);
    font-size: 0.9rem;
}

/* ============================================================
   BEFORE / AFTER SLIDER
============================================================ */
.slider-section {
    position: relative;
}

.slider-wrapper {
    position: relative;
    margin-top: 20px;
    border-radius: 16px;
    overflow: hidden;
    border: 1px solid var(--border-soft);
}

.slider-before,
.slider-after {
    width: 100%;
    display: block;
}

.slider-handle {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 50%;
    width: 4px;
    background: var(--accent-gold);
    opacity: 0.7;
}

/* ============================================================
   GALLERY
============================================================ */
.gallery-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 18px;
    margin-top: 16px;
}

.gallery-item {
    position: relative;
    border-radius: 14px;
    overflow: hidden;
    border: 1px solid var(--border-soft);
}

.gallery-item img {
    width: 100%;
    height: 220px;
    object-fit: cover;
    transition: 0.25s ease;
}

.gallery-item .overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(0,0,0,0.75), transparent);
    display: flex;
    align-items: flex-end;
    justify-content: center;
    padding-bottom: 12px;
    font-size: 0.95rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent-gold);
    opacity: 0;
    transition: 0.25s ease;
}

.gallery-item:hover img {
    transform: scale(1.05);
}

.gallery-item:hover .overlay {
    opacity: 1;
}

/* ============================================================
   FAQ
============================================================ */
.faq-list {
    margin-top: 16px;
    display: flex;
    flex-direction: column;
    gap: 14px;
}

.faq-item {
    background: var(--bg-card);
    border-radius: 12px;
    padding: 16px 18px;
    border: 1px solid #181822;
}

.faq-item h3 {
    font-size: 1rem;
    margin-bottom: 6px;
}

.faq-item p {
    font-size: 0.9rem;
    color: var(--text-muted);
}

/* ============================================================
   CONTACT
============================================================ */
.contact-wrapper {
    display: flex;
    gap: 40px;
    flex-wrap: wrap;
    margin-top: 16px;
}

.contact-form {
    flex: 1;
    min-width: 280px;
    display: flex;
    flex-direction: column;
    gap: 12px;
}

.contact-form label {
    font-size: 0.85rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
}

.contact-form input,
.contact-form textarea {
    background: var(--bg-soft);
    border: 1px solid var(--border-soft);
    padding: 12px;
    border-radius: 8px;
    color: #fff;
    font-size: 0.9rem;
}

.contact-form textarea {
    min-height: 120px;
    resize: vertical;
}

.contact-form button {
    margin-top: 6px;
    background: linear-gradient(135deg, var(--accent-red), #ff335c);
    border: none;
    padding: 12px;
    border-radius: 999px;
    color: #fff;
    font-weight: 600;
    cursor: pointer;
    transition: 0.2s ease;
}

.contact-form button:hover {
    transform: translateY(-2px);
}

.contact-info {
    flex: 1;
    min-width: 260px;
    font-size: 0.9rem;
}

.contact-info p {
    margin-bottom: 6px;
}

.contact-info a {
    color: var(--accent-gold);
    text-decoration: none;
}

.contact-info a:hover {
    text-decoration: underline;
}

.map-small {
    margin-top: 16px;
    width: 100%;
    height: 220px;
    border-radius: 12px;
    overflow: hidden;
    border: 1px solid var(--border-soft);
}

.map-small iframe {
    width: 100%;
    height: 100%;
}

/* ============================================================
   RESPONSIVE
============================================================ */
@media (max-width: 900px) {
    .top-nav {
        padding: 14px 20px;
    }

    .nav-links {
        gap: 16px;
    }

    .hero {
        padding: 120px 30px 0; /* responsive fix */
    }

    .hero-title {
        font-size: 2.6rem;
    }

    .timeline::before {
        display: none;
    }

    .timeline {
        flex-direction: column;
        align-items: flex-start;
    }

    .timeline-step {
        text-align: left;
    }
}

@media (max-width: 600px) {
    .hero {
        padding: 110px 22px 0; /* mobile fix */
    }

    .hero-title {
        font-size: 2.2rem;
    }

    .section {
        padding: 80px 22px;
    }

    .top-nav {
        padding: 12px 16px;
    }

    .nav-links {
        display: none; /* mobile menu later */
    }
}
